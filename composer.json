{
    "name": "webanyone/form-field-duplicator",
    "description": "Duplicate native form fields and conditional children in the Mautic editor draft",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1 <8.5",
        "ext-simplexml": "*",
        "mautic/core-lib": ">=6.0.9 <6.1",
        "composer/installers": "^1.11 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\WebAnyOneFormFieldDuplicatorBundle\\": ""
        }
    },
    "extra": {
        "installer-name": "WebAnyOneFormFieldDuplicatorBundle",
        "install-directory-name": "WebAnyOneFormFieldDuplicatorBundle"
    },
    "homepage": "https://github.com/WebAnyOne/mautic-form-field-duplicator",
    "support": {
        "issues": "https://github.com/WebAnyOne/mautic-form-field-duplicator/issues",
        "source": "https://github.com/WebAnyOne/mautic-form-field-duplicator"
    },
    "keywords": [
        "mautic",
        "plugin",
        "forms",
        "duplication"
    ],
    "authors": [
        {
            "name": "WebAnyOne"
        }
    ],
    "archive": {
        "exclude": [
            "/.github",
            "/scripts",
            "/Tests",
            "/phpunit.xml.dist",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/dist"
        ]
    }
}
